rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mỗi học sinh chỉ đọc/ghi đúng tài liệu của mình, và chỉ khi email đã xác minh.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['wrong', 'learned', 'updatedAt'])
          && (!('wrong' in d) || d.wrong is map)
          && (!('learned' in d) || d.learned is map)
          && (!('updatedAt' in d) || d.updatedAt is int);
      }
      allow get: if isOwner();
      allow create, update: if isOwner() && validData();
      allow list, delete: if false;   // không ai liệt kê được danh sách học sinh
    }

    // Mọi thứ khác: cấm.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
